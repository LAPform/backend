# Configuration FormForge POC
# Copier ce fichier vers .env et modifier les valeurs

# Configuration Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Base de données SQLite (compatible Render gratuit)
DATABASE_URL=sqlite:///formforge_poc.db

# Configuration Flask-Mail pour la réinitialisation de mot de passe
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@formforge.com

# Configuration CORS (pour le développement)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Configuration upload
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=16777216

# Logging
LOG_LEVEL=INFO
